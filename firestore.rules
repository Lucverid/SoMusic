rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // IMPORTANT: ganti dengan email admin Firebase Authentication milik kasir/admin.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == 'GANTI_DENGAN_EMAIL_ADMIN';
    }

    match /venues/{venueId}/meta/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /venues/{venueId}/requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.deviceId is string
        && request.resource.data.tableId is string
        && request.resource.data.title is string
        && request.resource.data.artist is string
        && request.resource.data.status in ['pending', 'approved'];
      allow update, delete: if isAdmin();
    }

    match /venues/{venueId}/queue/{queueId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /venues/{venueId}/history/{historyId} {
      allow read, write: if isAdmin();
    }
  }
}
